{
  "name": "ytdlp-api",
  "version": "1.0.0",
  "description": "A simple Node.js API to fetch YouTube download links using yt-dlp.",
  "main": "index.js",
  "scripts": {
    "prestart": "curl -L -o node_modules/youtube-dl-exec/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux && chmod +x node_modules/youtube-dl-exec/bin/yt-dlp",
    "start": "node index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "youtube-dl-exec": "^3.0.1"
  }
}
